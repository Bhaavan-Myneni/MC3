{
  "name": "mc3-summit-2025",
  "version": "1.0.0",
  "description": "Monroe County Childhood Conditions Summit 2025 - Data Portal",
  "main": "index.html",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "dev": "python3 -m http.server 8000",
    "build": "echo 'Static site - no build required'",
    "deploy": "echo 'Deploy using Vercel CLI or GitHub integration'",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test tests/api.spec.ts",
    "test:visual": "playwright test --grep @visual",
    "test:visual:update": "playwright test --grep @visual --update-snapshots",
    "test:cross-browser": "playwright test --project=chromium --project=firefox --project=webkit --project=mobile-chrome"
  },
  "keywords": [
    "monroe-county",
    "childhood-conditions",
    "data-visualization",
    "government",
    "summit"
  ],
  "author": "MC3 Summit 2025 Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/mc3-summit-2025.git"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
