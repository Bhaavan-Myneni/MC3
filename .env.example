# MC3 Local PostgreSQL connection (optional)
# Copy to .env and adjust if needed. Do not commit .env with real secrets.
#
# Docker Compose default credentials:
#   user: mc3_user
#   password: mc3_password
#   database: mc3
#   port: 5432

DATABASE_URL=postgresql://mc3_user:mc3_password@localhost:5432/mc3
